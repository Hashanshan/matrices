{
  "appId": "com.matrices.catalogue",
  "appName": "Matrices Product Catalogue",
  "webDir": "out",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "Camera": {
      "permissions": ["camera", "photos"]
    },
    "Geolocation": {
      "permissions": ["location"]
    },
    "Filesystem": {
      "permissions": ["publicStorage"]
    }
  }
}
