{
  "appId": "com.matrices.catalogue",
  "appName": "Matrices",
  "webDir": "out",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "Camera": {
      "permissions": ["camera", "photos"]
    },
    "Geolocation": {
      "permissions": ["location"]
    },
    "Filesystem": {
      "permissions": ["publicStorage"]
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "statsUrl": "",
      "updateUrl": "https://matrices.devcodz.com/api/updates/version"
    }
  }
}
